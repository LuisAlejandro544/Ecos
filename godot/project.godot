; Archivo principal de configuración de Godot Engine 4.7.2
; Configurado específicamente para un juego móvil 3D de terror atmosférico.
; No utiliza configuraciones de exportación Web ni funciones incompatibles con móviles.

config_version=5

[application]

config/name="Ecos en la Penumbra"
config/description="Juego móvil 3D de terror en Godot 4.7.2: secuestro en el bosque y 3 noches para escapar."
config/version="0.2.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.02, 0.02, 0.028, 1)
boot_splash/show_image=true
config/icon="res://assets/branding/icon.svg"

[audio]

buses/default_bus_layout="res://resources/audio/horror_bus_layout.tres"

[autoload]

GameState="*res://scripts/core/game_state.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
AtmosphereDirector="*res://scripts/atmosphere/atmosphere_director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[input]

move_forward={
"deadzone": 0.2,
"events": []
}
move_backward={
"deadzone": 0.2,
"events": []
}
move_left={
"deadzone": 0.2,
"events": []
}
move_right={
"deadzone": 0.2,
"events": []
}
interact={
"deadzone": 0.2,
"events": []
}
flashlight_toggle={
"deadzone": 0.2,
"events": []
}
sprint={
"deadzone": 0.2,
"events": []
}
crouch={
"deadzone": 0.2,
"events": []
}
pause={
"deadzone": 0.2,
"events": []
}

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/driver.android="vulkan"
rendering_device/fallback_to_opengl3=true
gl_compatibility/fallback_to_angle=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/positional_shadow/atlas_size=1024
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_environment="res://resources/environments/abyss_horror_env.tres"
